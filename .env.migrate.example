# Old server (source) — read-only, only dumped from.
# The prod container must be able to reach this host over the internet.
SOURCE_HOST='old-server.example.com'
SOURCE_PORT=5432
SOURCE_DB='farmfills'
SOURCE_USER='farmfills'
SOURCE_PASS='...'

# Target = this container's own database. Taken automatically from the app's
# DATABASE_URL (or DATABASE_HOST/PORT/NAME/USER/PASS), so normally leave the
# lines below alone. Uncomment only to override.
# TARGET_HOST=''
# TARGET_PORT=5432
# TARGET_DB=''
# TARGET_USER=''
# TARGET_PASS=''

# Optional: where to write the dump inside the container.
# DUMP_FILE='/tmp/farmfills.dump'
